#pragma once

// Copy this file to config.h and set these pins for the exact ESP32-C3 board.
// The defaults below are a proposed custom-PCB pin plan, not universal dev-board pins.

constexpr uint32_t GPS_BAUD = 9600;
constexpr int GPS_RX_PIN = 16;  // ESP32 RX <- GPS TX; matches the tested original build
constexpr int GPS_TX_PIN = 17;  // ESP32 TX -> GPS RX; matches the tested original build

constexpr int TFT_SCLK_PIN = 4;
constexpr int TFT_MOSI_PIN = 6;
constexpr int TFT_CS_PIN = 7;
constexpr int TFT_DC_PIN = 2;
constexpr int TFT_RST_PIN = 3;

constexpr uint8_t TFT_ROTATION = 2;
constexpr bool MAP_FLIP_X = false;
constexpr bool MAP_FLIP_Y = false;

constexpr float FALLBACK_LATITUDE = 1.3521f;
constexpr float FALLBACK_LONGITUDE = 103.8198f;
constexpr uint32_t RENDER_INTERVAL_MS = 30'000UL;
constexpr float MAGNITUDE_CUTOFF = 4.5f;
constexpr float LABEL_MAGNITUDE_CUTOFF = 2.0f;
